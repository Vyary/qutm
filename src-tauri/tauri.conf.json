{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qutm",
  "version": "../package.json",
  "identifier": "qutm",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun scripts/sync-version.js && bun run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "Qutm",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "focusable": true,
        "shadow": false,
        "width": 0,
        "height": 0
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true
    }
  }
}